[global]
font = JetBrainsMono Nerd Font 10
corner_radius = 16
origin = top-right
offset = 16x16
width = (340, 440)
padding = 14
horizontal_padding = 16
frame_width = 1
frame_color = "#38bdf8"
separator_color = "#1e293b"
hide_duplicate_count = true
stack_duplicates = true
icon_position = left
min_icon_size = 32
max_icon_size = 48
icon_path = /usr/share/icons/Papirus-Dark/48x48/status/:/usr/share/icons/Papirus/48x48/status/:/usr/share/icons/Papirus-Dark/48x48/apps/:/usr/share/icons/Papirus/48x48/apps/:/usr/share/icons/hicolor/48x48/apps/:/usr/share/pixmaps/
progress_bar = true
progress_bar_height = 6
progress_bar_frame_width = 0
progress_bar_min_width = 220
progress_bar_max_width = 380
format = "<b>%s</b>\n<span font='9.5' color='#94a3b8'>%b</span>"
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
background = "#0e1118"
foreground = "#94a3b8"
frame_color = "#1e293b"
highlight = "#38bdf8"
timeout = 3

[urgency_normal]
background = "#0e1118"
foreground = "#f1f5f9"
frame_color = "#38bdf8"
highlight = "#38bdf8"
timeout = 5

[urgency_critical]
background = "#140e12"
foreground = "#fda4af"
frame_color = "#f43f5e"
highlight = "#f43f5e"
timeout = 0

[osd]
category = "osd"
history_ignore = yes
timeout = 2
format = "<b>%s</b> <span color='#38bdf8'>%b</span>"
