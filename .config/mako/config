# ==============================================================================
# Mako Notification Daemon — Modern Obsidian Glass Design
# ==============================================================================

# Joylashuv va geometriya
layer=overlay
anchor=top-right
width=420
margin=10,18,10,0
padding=16,20
border-size=1
border-radius=14

# Tipografiya va asosiy ranglar
font=Cantarell 12
background-color=#0f1117f2
text-color=#f3f4f6
border-color=#3b82f666
progress-color=over #3b82f6ee

# Piktogrammalar (Icons)
icons=1
max-icon-size=48
icon-location=left
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus:/usr/share/icons/hicolor:/usr/share/pixmaps

# Taymer va harakatlar
default-timeout=5000
ignore-timeout=0

format=<b><span size="larger">%s</span></b>\n%b

on-button-left=dismiss
on-button-right=dismiss-all
on-touch=dismiss

# Muhimlik darajalari (Urgency)
[urgency=low]
border-color=#27272a
default-timeout=3000

[urgency=normal]
border-color=#3b82f688
default-timeout=5000

[urgency=critical]
border-color=#ef4444
text-color=#ffffff
default-timeout=0

# OSD (Ovoz va Yorug'lik indikatori)
[category=osd]
default-timeout=1200
width=360
border-color=#6366f1aa
progress-color=over #6366f1ee
format=<b>%s</b>\n%b
history=0



