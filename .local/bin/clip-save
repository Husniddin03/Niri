#!/usr/bin/env python3
import sys
import os
import json
import hashlib
import time
import signal
import subprocess

# ── 1. Watchdog: Maksimal 2 soniya (osilib qolishni 100% oldini oladi) ────────
signal.alarm(2)

CACHE_DIR = os.path.expanduser("~/.cache/clip_history")
IMAGES_DIR = os.path.join(CACHE_DIR, "images")
HISTORY_FILE = os.path.join(CACHE_DIR, "history.json")

os.makedirs(IMAGES_DIR, exist_ok=True)

# Chegaralar (Katta ma'lumotlarda tizim qotib qolmasligi uchun)
MAX_PAYLOAD = 2 * 1024 * 1024       # 2 MB dan katta oqimlarni tarixga kiritmaymiz
MAX_TEXT_STORE = 100 * 1024         # Matn uchun maksimal 100 KB (tarix shishib ketmasligi uchun)
MAX_IMAGE_SIZE = 5 * 1024 * 1024    # Rasm uchun maksimal 5 MB
MAX_HISTORY_ENTRIES = 40            # Maksimal 40 ta yozuv

def load_history():
    if os.path.exists(HISTORY_FILE):
        try:
            with open(HISTORY_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return []
    return []

def save_history(history):
    history = history[:MAX_HISTORY_ENTRIES]
    tmp_file = HISTORY_FILE + ".tmp"
    with open(tmp_file, "w", encoding="utf-8") as f:
        json.dump(history, f, ensure_ascii=False, indent=1)
    os.replace(tmp_file, HISTORY_FILE)

def is_image(b):
    if len(b) < 16:
        return None
    if b.startswith(b'\x89PNG\r\n\x1a\n'):
        return 'png'
    if b.startswith(b'\xff\xd8\xff'):
        return 'jpg'
    if b.startswith(b'GIF8'):
        return 'gif'
    if b.startswith(b'RIFF') and b'WEBP' in b[:16]:
        return 'webp'
    if b.startswith(b'BM'):
        return 'bmp'
    return None

try:
    # ── 2. Xavfsiz chunked o'qish (Hajm nazorati bilan) ──────────────────────
    chunks = []
    total_bytes = 0
    overflow = False

    while True:
        chunk = sys.stdin.buffer.read(65536)
        if not chunk:
            break
        total_bytes += len(chunk)
        if total_bytes > MAX_PAYLOAD:
            overflow = True
            # Pipe tiqilib manba dastur qotmasligi uchun qolganini tezda bo'shatamiz
            while sys.stdin.buffer.read(65536):
                pass
            break
        chunks.append(chunk)

    if overflow or not chunks:
        # Juda katta hajmdagi ma'lumot yoki bo'sh oqim — tarixga saqlanmaydi, dastur darhol ozod bo'ladi
        sys.exit(0)

    raw_bytes = b"".join(chunks)
    img_type = is_image(raw_bytes)

    if img_type:
        # ── 3. Rasm bilan ishlash ─────────────────────────────────────────────
        if len(raw_bytes) > MAX_IMAGE_SIZE:
            sys.exit(0)

        img_hash = hashlib.md5(raw_bytes).hexdigest()[:16]
        img_path = os.path.join(IMAGES_DIR, f"{img_hash}.{img_type}")
        thumb_path = os.path.join(IMAGES_DIR, f"{img_hash}_thumb.png")

        history = load_history()
        if history and history[0].get("type") == "image" and history[0].get("hash") == img_hash:
            sys.exit(0)

        if not os.path.exists(img_path):
            with open(img_path, "wb") as f:
                f.write(raw_bytes)
            # Timeout 1.0s bilan thumbnail yaratish (CPU tiqilmasligi uchun)
            try:
                subprocess.run(
                    ["convert", img_path, "-thumbnail", "64x64^", "-gravity", "center", "-extent", "64x64", thumb_path],
                    stderr=subprocess.DEVNULL, timeout=1.0
                )
            except Exception:
                pass

        history = [h for h in history if not (h.get("type") == "image" and h.get("hash") == img_hash)]

        dim_out = ""
        try:
            res = subprocess.run(["identify", "-format", "%wx%h", img_path], capture_output=True, text=True, timeout=0.8)
            dim_out = res.stdout.strip()
        except Exception:
            pass

        preview_text = f"📷 Rasm ({dim_out})" if dim_out else f"📷 Nusxalangan rasm ({img_type})"

        history.insert(0, {
            "type": "image",
            "hash": img_hash,
            "file": img_path,
            "thumb": thumb_path if os.path.exists(thumb_path) else img_path,
            "preview": preview_text,
            "time": int(time.time())
        })
        save_history(history)

    else:
        # ── 4. Matn bilan ishlash ──────────────────────────────────────────────
        try:
            data = raw_bytes.decode("utf-8")
        except UnicodeDecodeError:
            data = raw_bytes.decode("utf-8", errors="replace")

        if not data or not data.strip():
            sys.exit(0)

        history = load_history()
        if history and history[0].get("type") == "text" and history[0].get("content") == data:
            sys.exit(0)

        history = [h for h in history if not (h.get("type") == "text" and h.get("content") == data)]

        lines = data.strip().splitlines()
        first_line = lines[0] if lines else ""
        if len(first_line) > 60:
            first_line = first_line[:57] + "..."
        if len(lines) > 1:
            first_line += " 📑"

        # Agar matn juda katta bo'lsa, contentni kesib saqlaymiz
        store_data = data[:MAX_TEXT_STORE] if len(data) > MAX_TEXT_STORE else data

        history.insert(0, {
            "type": "text",
            "content": store_data,
            "preview": first_line,
            "time": int(time.time())
        })
        save_history(history)

except Exception:
    pass
