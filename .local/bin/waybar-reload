#!/usr/bin/env bash
# ==============================================================================
# Waybar Smart Reload
# ==============================================================================
STATE_FILE="/tmp/waybar_state"

if pgrep -x "waybar" > /dev/null; then
    killall -SIGUSR2 waybar 2>/dev/null
else
    niri msg action spawn -- waybar
fi

# Qayta yuklanganda Waybar odatda yashirin (mode: hide) holatda boshlanadi
sleep 0.35
is_open=$(niri msg -j overview-state 2>/dev/null | jq -r '.is_open')

if [ "$is_open" = "true" ]; then
    echo "shown" > "$STATE_FILE"
    killall -SIGUSR1 waybar 2>/dev/null
else
    echo "hidden" > "$STATE_FILE"
fi
