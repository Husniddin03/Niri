#!/usr/bin/env bash

# Toggle if running
if pgrep -f "smart_clipboard.py" >/dev/null; then
    pkill -f "smart_clipboard.py"
    rm -f /tmp/smart-clipboard.pid
    exit 0
fi

export NO_AT_BRIDGE=1
export GTK_A11Y=none
export XDG_DATA_DIRS="/usr/share:/usr/local/share:$HOME/.local/share:$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS}"

exec python3 $HOME/.config/wofi/clipboard/smart_clipboard.py "$@"
