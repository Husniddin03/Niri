#!/usr/bin/env bash

IFACE="wlo1"
HOTSPOT_CON="NiriHotspot"

IS_ACTIVE=$(nmcli -t -f NAME,DEVICE connection show --active | grep "^${HOTSPOT_CON}:${IFACE}$")

if [ -z "$IS_ACTIVE" ]; then
    echo "ℹ️  Hotspot (Niri) hozirda o'chiq holatda."
    exit 0
fi

echo "📡 Hotspot (Niri) holati: FAOL"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📱 Ulangan qurilmalar ro'yxati:"
echo ""

DEVICES=$(ip neigh show dev "$IFACE" | grep -v "FAILED")

if [ -n "$DEVICES" ]; then
    printf "%-18s %-20s %-10s\n" "IP MANZIL" "MAC MANZIL" "HOLATI"
    echo "----------------------------------------------------"
    echo "$DEVICES" | while read -r line; do
        ip=$(echo "$line" | awk '{print $1}')
        mac=$(echo "$line" | awk '{print $3}')
        state=$(echo "$line" | awk '{print $4}')
        printf "%-18s %-20s %-10s\n" "$ip" "$mac" "$state"
    done
else
    echo "Hozircha hech qanday qurilma ulanmagan."
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
