def load_config():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            cfg = json.load(f)
            for k, v in DEFAULT_CONFIG.items():
                if k not in cfg:
                    cfg[k] = v
            if "openai" not in cfg.get("providers", {}):
                cfg["providers"]["openai"] = DEFAULT_CONFIG["providers"]["openai"]
            return cfg
    except Exception:
        return DEFAULT_CONFIG

def save_config(cfg):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2, ensure_ascii=False)
    except Exception:
        pass

def get_api_key(provider_info):
    if provider_info.get("api_key"):
        return provider_info["api_key"].strip()
    key_env = provider_info.get("api_key_env", "")
    if key_env:
        val = os.environ.get(key_env)
        if val:
            return val.strip()
        bashrc = os.path.expanduser("~/.bashrc")
        if os.path.exists(bashrc):
            with open(bashrc, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    if f"{key_env}=" in line:
                        return line.split(f"{key_env}=")[1].strip().strip('"').strip("'")
    return ""

def fetch_live_models(provider_id, provider_info):
    api_key = get_api_key(provider_info)
    ptype = provider_info.get("type", "gemini")

    if ptype == "gemini" and api_key:
        try:
            url = f"https://generativelanguage.googleapis.com/v1beta/models?key={api_key}"
            req = urllib.request.Request(url)
            with urllib.request.urlopen(req, timeout=4) as r:
                data = json.loads(r.read().decode("utf-8"))
                models = []
                for m in data.get("models", []):
                    if "generateContent" in m.get("supportedGenerationMethods", []):
                        name = m["name"].replace("models/", "")
                        if name.startswith("gemini-") and not any(x in name for x in ["image", "tts", "robotics"]):
                            models.append(name)
                models.sort(reverse=True)
                return models
        except Exception:
            pass

    elif ptype == "openai" and api_key:
        try:
            base_url = provider_info.get("base_url", "https://api.openai.com/v1").rstrip("/")
            url = f"{base_url}/models"
            req = urllib.request.Request(url, headers={"Authorization": f"Bearer {api_key}"})
            with urllib.request.urlopen(req, timeout=4) as r:
                data = json.loads(r.read().decode("utf-8"))
                models = [m["id"] for m in data.get("data", [])]
                models.sort()
                return models
        except Exception:
            pass

    return provider_info.get("models", [])

def copy_to_clipboard(text):
    try:
        p = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE)
        p.communicate(input=text.encode("utf-8"))
    except Exception:
        pass

def query_ai_conversation(history, config=None):
    """Ko'p qadamli davomiy suhbat (Multi-turn Chat) uchun API chaqiruvi"""
    if not config:
        config = load_config()

    provider_id = config.get("active_provider", "gemini")
    model = config.get("active_model", "gemini-3.8-flash")
    providers = config.get("providers", {})
    provider_info = providers.get(provider_id, {})
    ptype = provider_info.get("type", "gemini")
    api_key = get_api_key(provider_info)

    if not api_key and provider_id != "custom_local":
        key_name = provider_info.get("api_key_env", "API_KEY")
        return f"❌ Kalit topilmadi!\n~/.config/quick-ai/config.json faylida {key_name} ni kiriting."

    if ptype == "gemini":
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
        contents = []

        for item in history:
            role = "user" if item["role"] == "user" else "model"
            parts = [{"text": item["text"]}]
            if item.get("image_b64"):
                parts.append({
                    "inline_data": {
                        "mime_type": "image/png",
                        "data": item["image_b64"]
                    }
                })
            contents.append({"role": role, "parts": parts})

        payload = {"contents": contents}
        req_data = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(url, data=req_data, headers={"Content-Type": "application/json"})

        try:
            with urllib.request.urlopen(req, timeout=35) as resp:
                res = json.loads(resp.read().decode("utf-8"))
                return res["candidates"][0]["content"]["parts"][0]["text"].strip()
        except urllib.error.HTTPError as e:
            try:
                err_body = json.loads(e.read().decode("utf-8"))
                msg = err_body.get('error', {}).get('message', str(e))
                return f"❌ Gemini API ({e.code}):\n{msg}"
            except Exception:
                return f"❌ Gemini API Xatosi: {e}"
        except Exception as e:
            return f"❌ Ulanishda xatolik: {e}"

    elif ptype == "openai":
        base_url = provider_info.get("base_url", "https://api.openai.com/v1").rstrip("/")
        url = f"{base_url}/chat/completions"

        messages = []
        for item in history:
            role = "user" if item["role"] == "user" else "assistant"
            if item.get("image_b64"):
                data_url = f"data:image/png;base64,{item['image_b64']}"
                messages.append({
                    "role": role,
                    "content": [
                        {"type": "text", "text": item["text"]},
                        {"type": "image_url", "image_url": {"url": data_url}}
                    ]
                })
            else:
                messages.append({"role": role, "content": item["text"]})

        payload = {
            "model": model,
            "messages": messages,
            "temperature": config.get("temperature", 0.3)
        }
        headers = {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}" if api_key else ""
        }
        req_data = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(url, data=req_data, headers=headers)

        try:
            with urllib.request.urlopen(req, timeout=35) as resp:
                res = json.loads(resp.read().decode("utf-8"))
                return res["choices"][0]["message"]["content"].strip()
        except urllib.error.HTTPError as e:
            try:
                err_body = json.loads(e.read().decode("utf-8"))
                msg = err_body.get('error', {}).get('message', str(e))
                return f"❌ OpenAI API ({e.code}):\n{msg}"
            except Exception:
                return f"❌ API Xatosi: {e}"
        except Exception as e:
            return f"❌ Xatolik: {e}"

    return "❌ Noma'lum provayder turi"

