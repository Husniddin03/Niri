class QuickAIWindow(Gtk.Window):
    def __init__(self, mode="ask", image_path=None):
        super().__init__(title="Tezkor AI")

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        
        self.set_default_size(820, 560)
        self.set_position(Gtk.WindowPosition.CENTER)

        self.mode = mode
        self.image_path = image_path
        self.config = load_config()
        self.conversation_history = []  # List of dicts: {"role": "user"/"model", "text": "...", "image_b64": "..."}
        self.model_changed_handler_id = None
        self.is_querying = False

        self.apply_css()

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        main_box.set_size_request(820, 560)
        main_box.get_style_context().add_class("minimal-card")
        self.add(main_box)

        # 1. Top Bar
        top_bar = self.build_top_bar()
        main_box.pack_start(top_bar, False, False, 0)

        # 2. Chat Feed Area (Continuous Conversation View)
        self.feed_scrolled = Gtk.ScrolledWindow()
        self.feed_scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.feed_scrolled.set_shadow_type(Gtk.ShadowType.NONE)

        self.feed_view = Gtk.TextView()
        self.feed_view.set_editable(False)
        self.feed_view.set_cursor_visible(False)
        self.feed_view.set_wrap_mode(Gtk.WrapMode.WORD)
        self.feed_view.get_style_context().add_class("chat-feed")
        self.feed_buffer = self.feed_view.get_buffer()
        self.setup_tags(self.feed_buffer)

        self.feed_scrolled.add(self.feed_view)
        main_box.pack_start(self.feed_scrolled, True, True, 0)

        # 3. Persistent Bottom Input Area (Shift+Enter to send)
        input_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        input_box.get_style_context().add_class("input-box")

        self.input_scrolled = Gtk.ScrolledWindow()
        self.input_scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.input_scrolled.set_min_content_height(54)
        self.input_scrolled.set_max_content_height(120)

        self.prompt_view = Gtk.TextView()
        self.prompt_view.set_wrap_mode(Gtk.WrapMode.WORD)
        self.prompt_view.get_style_context().add_class("input-area")
        self.prompt_buffer = self.prompt_view.get_buffer()
        self.prompt_buffer.set_text("Savolingizni yozing...")

        self.placeholder_active = True
        self.prompt_view.connect("focus-in-event", self.on_prompt_focus_in)
        self.prompt_view.connect("key-press-event", self.on_prompt_key_press)
        self.input_scrolled.add(self.prompt_view)

        input_meta_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        hint = Gtk.Label(label="Shift+Enter — Yuborish  |  Enter — Yangi qator  |  Ctrl+N — Yangi suhbat  |  Esc — Yopish")
        hint.get_style_context().add_class("shortcut-hint")
        hint.set_halign(Gtk.Align.START)
        input_meta_bar.pack_start(hint, True, True, 0)

        input_box.pack_start(self.input_scrolled, False, False, 0)
        input_box.pack_start(input_meta_bar, False, False, 0)
        main_box.pack_end(input_box, False, False, 0)

        self.connect("key-press-event", self.on_window_key_press)
        self.connect("destroy", self.on_destroy)

        self.show_all()
        GLib.idle_add(self.prompt_view.grab_focus)

        # Handle initial snapshot or prompt
        if self.mode == "snap" and self.image_path:
            self.start_snap_conversation()

        # Dynamic model fetch from live API
        threading.Thread(target=self.bg_fetch_live_models, daemon=True).start()

    def apply_css(self):
        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", True)
            settings.set_property("gtk-theme-name", "Adwaita-dark")

        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(CSS_STYLE.encode("utf-8"))
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(screen, css_provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)

    def build_top_bar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        bar.get_style_context().add_class("top-bar")

        self.model_combo = Gtk.ComboBoxText.new_with_entry()
        self.model_entry = self.model_combo.get_child()
        self.model_entry.set_placeholder_text("Model nomi...")

        self.populate_models()
        self.model_changed_handler_id = self.model_combo.connect("changed", self.on_model_changed)
        self.model_entry.connect("activate", self.on_model_entry_activated)
        bar.pack_start(self.model_combo, False, False, 0)

        self.toast_lbl = Gtk.Label(label="")
        self.toast_lbl.get_style_context().add_class("toast-pill")
        bar.pack_end(self.toast_lbl, False, False, 0)

        return bar

    def populate_models(self, extra_models=None):
        if self.model_changed_handler_id is not None:
            self.model_combo.handler_block(self.model_changed_handler_id)

        self.model_combo.remove_all()
        providers = self.config.get("providers", {})
        active_prov = self.config.get("active_provider", "gemini")
        active_model = self.config.get("active_model", "gemini-3.8-flash")

        pdata = providers.get(active_prov, {})
        models = extra_models if extra_models else pdata.get("models", [])

        if active_model not in models:
            models = [active_model] + models

        for m in models:
            self.model_combo.append_text(m)

        self.model_entry.set_text(active_model)

        if self.model_changed_handler_id is not None:
            self.model_combo.handler_unblock(self.model_changed_handler_id)

    def bg_fetch_live_models(self):
        active_prov = self.config.get("active_provider", "gemini")
        pdata = self.config.get("providers", {}).get(active_prov, {})
        live_models = fetch_live_models(active_prov, pdata)
        if live_models:
            self.config["providers"][active_prov]["models"] = live_models
            save_config(self.config)
            GLib.idle_add(lambda: self.populate_models(live_models))

    def on_model_changed(self, combo):
        text = combo.get_active_text()
        if text:
            self.config["active_model"] = text.strip()
            save_config(self.config)
            self.show_toast(f"Model: {text.strip()}")

    def on_model_entry_activated(self, entry):
        custom_model = entry.get_text().strip()
        if custom_model:
            self.config["active_model"] = custom_model
            save_config(self.config)
            self.show_toast(f"Model: {custom_model}")

    def show_toast(self, msg, duration_ms=2000):
        self.toast_lbl.set_text(msg)
        GLib.timeout_add(duration_ms, lambda: self.toast_lbl.set_text(""))

    def setup_tags(self, buf):
        buf.create_tag("role_user", weight=Pango.Weight.BOLD, foreground="#38bdf8", size_points=12.5)
        buf.create_tag("role_ai", weight=Pango.Weight.BOLD, foreground="#10b981", size_points=12.5)
        buf.create_tag("user_text", foreground="#f8fafc", left_margin=4)
        buf.create_tag("h1", weight=Pango.Weight.BOLD, size_points=14.5, foreground="#38bdf8")
        buf.create_tag("h2", weight=Pango.Weight.BOLD, size_points=13.5, foreground="#60a5fa")
        buf.create_tag("bold", weight=Pango.Weight.BOLD, foreground="#ffffff")
        buf.create_tag("code", family="JetBrains Mono", background="#1a202c", foreground="#7dd3fc")
        buf.create_tag("body", foreground="#f1f5f9")
        buf.create_tag("sep", foreground="#1e2430")

    def append_user_message(self, text):
        buf = self.feed_buffer
        end = buf.get_end_iter()
        if buf.get_char_count() > 0:
            buf.insert_with_tags_by_name(end, "\n────────────────────────────────────────────\n\n", "sep")
        
        end = buf.get_end_iter()
        buf.insert_with_tags_by_name(end, "👤 Siz\n", "role_user")
        end = buf.get_end_iter()
        buf.insert_with_tags_by_name(end, text + "\n\n", "user_text")
        self.scroll_to_bottom()

    def append_ai_message(self, text):
        buf = self.feed_buffer
        end = buf.get_end_iter()
        buf.insert_with_tags_by_name(end, "✦ AI\n", "role_ai")
        self.render_markdown(text)
        
        end = buf.get_end_iter()
        buf.insert(end, "\n")
        self.scroll_to_bottom()

    def render_markdown(self, text):
        buf = self.feed_buffer
        lines = text.split("\n")
        in_code = False

        for line in lines:
            if line.strip().startswith("```"):
                in_code = not in_code
                continue

            if in_code:
                buf.insert_with_tags_by_name(buf.get_end_iter(), "  " + line + "\n", "code")
                continue

            if line.startswith("# "):
                buf.insert_with_tags_by_name(buf.get_end_iter(), line[2:].strip() + "\n", "h1")
            elif line.startswith("## ") or line.startswith("### "):
                buf.insert_with_tags_by_name(buf.get_end_iter(), line.lstrip("#").strip() + "\n", "h2")
            elif line.strip().startswith("* ") or line.strip().startswith("- "):
                clean = line.strip()[2:]
                buf.insert_with_tags_by_name(buf.get_end_iter(), " • ", "bold")
                self.render_inline(clean)
                buf.insert(buf.get_end_iter(), "\n")
            else:
                self.render_inline(line)
                buf.insert(buf.get_end_iter(), "\n")

    def render_inline(self, line):
        buf = self.feed_buffer
        parts = line.split("**")
        for i, part in enumerate(parts):
            if not part:
                continue
            if i % 2 == 1:
                buf.insert_with_tags_by_name(buf.get_end_iter(), part, "bold")
            else:
                subparts = part.split("`")
                for j, sub in enumerate(subparts):
                    if not sub:
                        continue
                    if j % 2 == 1:
                        buf.insert_with_tags_by_name(buf.get_end_iter(), f" {sub} ", "code")
                    else:
                        buf.insert_with_tags_by_name(buf.get_end_iter(), sub, "body")

    def scroll_to_bottom(self):
        GLib.idle_add(self._do_scroll)

    def _do_scroll(self):
        adj = self.feed_scrolled.get_vadjustment()
        adj.set_value(adj.get_upper() - adj.get_page_size())

    def on_prompt_focus_in(self, widget, event):
        if self.placeholder_active:
            self.prompt_buffer.set_text("")
            self.placeholder_active = False

    def on_prompt_key_press(self, widget, event):
        # Shift + Enter: sends query!
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if event.state & Gdk.ModifierType.SHIFT_MASK:
                self.submit_current_prompt()
                return True
        return False

    def on_window_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape or event.hardware_keycode == 9:
            self.close_window()
            return True
        # Ctrl + N: Clear chat & start fresh conversation
        if (event.state & Gdk.ModifierType.CONTROL_MASK) and event.keyval in (Gdk.KEY_n, Gdk.KEY_N, Gdk.KEY_l, Gdk.KEY_L):
            self.clear_conversation()
            return True
        return False

    def clear_conversation(self):
        self.conversation_history = []
        self.feed_buffer.set_text("")
        self.show_toast("Yangi suhbat boshlandi")
        self.prompt_buffer.set_text("")
        self.placeholder_active = False
        self.prompt_view.grab_focus()

    def close_window(self):
        cleanup_pid()
        Gtk.main_quit()

    def on_destroy(self, *args):
        cleanup_pid()
        Gtk.main_quit()

    def submit_current_prompt(self):
        if self.is_querying:
            return

        start, end = self.prompt_buffer.get_bounds()
        text = self.prompt_buffer.get_text(start, end, True).strip()
        if not text or self.placeholder_active:
            return

        self.append_user_message(text)
        self.conversation_history.append({"role": "user", "text": text})

        # Clear input field for next follow-up question
        self.prompt_buffer.set_text("")
        self.placeholder_active = False
        self.show_toast("✦ O'ylamoqda...")
        self.is_querying = True

        threading.Thread(target=self.run_conversation_thread, daemon=True).start()

    def start_snap_conversation(self):
        prompt = (
            "Sen ekrandagi belgilangan hududni tahlil qiluvchi aqlli AI yordamchisan. "
            "Ushbu rasmga qarab quyidagilarni aniq va lo'nda bajar:\n"
            "1. Agar rasmda chet tilidagi matn yoki maqola bo'lsa, uni o'zbek tiliga aniq, ravon tarjima qil.\n"
            "2. Agar dasturlash kodi yoki xatolik (error, trace) bo'lsa, uning asl sababini va aniq yechimini ko'rsat.\n"
            "3. Agar biror grafik yoki interfeys bo'lsa, asosiy ma'lumotini tushuntir.\n"
            "Javobni o'zbek tilida, tushunarli va amaliy qilib ber."
        )

        b64 = ""
        if os.path.exists(self.image_path):
            with open(self.image_path, "rb") as f:
                b64 = base64.b64encode(f.read()).decode("utf-8")

        self.append_user_message("📸 [Belgilangan ekran rasmi tahlili]")
        self.conversation_history.append({"role": "user", "text": prompt, "image_b64": b64})

        self.show_toast("📸 Ekran tahlil qilinmoqda...")
        self.is_querying = True
        threading.Thread(target=self.run_conversation_thread, daemon=True).start()

    def run_conversation_thread(self):
        ans = query_ai_conversation(self.conversation_history, self.config)
        GLib.idle_add(self.on_conversation_response, ans)

    def on_conversation_response(self, answer):
        self.is_querying = False
        self.conversation_history.append({"role": "model", "text": answer})
        self.append_ai_message(answer)
        copy_to_clipboard(answer)
        self.show_toast("✓ Nusxalandi!")
        self.prompt_view.grab_focus()

def main():
    check_single_instance()

    mode = sys.argv[1] if len(sys.argv) > 1 else "ask"
    img_path = None

    if mode == "snap":
        p = subprocess.run(["slurp"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        geometry = p.stdout.strip()
        if not geometry:
            cleanup_pid()
            sys.exit(0)

        img_path = "/tmp/quick_ai_snap.png"
        subprocess.run(["grim", "-g", geometry, img_path])
        if not os.path.exists(img_path) or os.path.getsize(img_path) == 0:
            cleanup_pid()
            sys.exit(0)

    win = QuickAIWindow(mode=mode, image_path=img_path)
    Gtk.main()

if __name__ == "__main__":
    main()
