xdg = os.environ.get("XDG_DATA_DIRS", "")
std_dirs = "/usr/share:/usr/local/share:" + os.path.expanduser("~/.local/share")
if "/usr/share" not in xdg:
    os.environ["XDG_DATA_DIRS"] = std_dirs + (":" + xdg if xdg else "")

PID_FILE = "/tmp/quick-ai.pid"

def check_single_instance():
    subprocess.run(["pkill", "-x", "slurp"], stderr=subprocess.DEVNULL)
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                old_pid = int(f.read().strip())
            os.kill(old_pid, signal.SIGTERM)
            os.remove(PID_FILE)
            sys.exit(0)
        except Exception:
            try:
                os.remove(PID_FILE)
            except Exception:
                pass
    try:
        with open(PID_FILE, "w") as f:
            f.write(str(os.getpid()))
    except Exception:
        pass

def cleanup_pid():
    if os.path.exists(PID_FILE):
        try:
            os.remove(PID_FILE)
        except Exception:
            pass

