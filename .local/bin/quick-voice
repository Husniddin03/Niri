#!/usr/bin/env python3
import os
import sys
import time
import json
import re
import base64
import signal
import subprocess
import threading
import urllib.request

PID_FILE = "/tmp/quick_voice_app.pid"
AUDIO_FILE = "/tmp/quick_voice_input.wav"

def get_api_key():
    key = os.environ.get("GEMINI_API_KEY", "").strip()
    if key:
        return key
    cfg_file = os.path.expanduser("~/.config/quick-ai/config.json")
    if os.path.isfile(cfg_file):
        try:
            with open(cfg_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                k = data.get("providers", {}).get("gemini", {}).get("api_key", "").strip()
                if k:
                    return k
        except Exception:
            pass
    bashrc = os.path.expanduser("~/.bashrc")
    if os.path.isfile(bashrc):
        try:
            with open(bashrc, "r", encoding="utf-8") as f:
                m = re.search(r'export\s+GEMINI_API_KEY=["\']?([^"\'\s]+)["\']?', f.read())
                if m:
                    return m.group(1).strip()
        except Exception:
            pass
    return ""

def transcribe_audio(audio_path, api_key):
    if not os.path.exists(audio_path) or os.path.getsize(audio_path) < 2000:
        return ""
    with open(audio_path, "rb") as f:
        b64_audio = base64.b64encode(f.read()).decode("utf-8")

    models_to_try = ["gemini-3.5-flash-lite", "gemini-3.1-flash-lite", "gemini-3.6-flash"]
    prompt = (
        "Ushbu audio yozuvdagi nutqni so'zma-so'z aniq matnga aylantirib ber. "
        "Tilni avtomatik aniqla (o'zbek, rus yoki ingliz). "
        "Matnni to'g'ri punktuatsiya (nuqta, vergul, so'roq) va bosh harflar bilan yoz. "
        "Faqat va faqat aytilgan nutq matnini qaytar, boshqa hech qanday izoh, salom yoki kirish so'z yozma."
    )
    last_err = ""
    for model in models_to_try:
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
        payload = {
            "contents": [{
                "parts": [
                    {"text": prompt},
                    {"inline_data": {"mime_type": "audio/wav", "data": b64_audio}}
                ]
            }],
            "generationConfig": {"temperature": 0.1, "maxOutputTokens": 1024}
        }
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"}
        )
        try:
            with urllib.request.urlopen(req, timeout=6) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                candidates = data.get("candidates", [])
                if candidates:
                    parts = candidates[0].get("content", {}).get("parts", [])
                    if parts:
                        return parts[0].get("text", "").strip()
        except Exception as e:
            last_err = str(e)
            continue
    return f"[Xatolik: {last_err}]"

# Check if another instance is already running
if os.path.exists(PID_FILE):
    try:
        with open(PID_FILE, "r") as f:
            old_pid = int(f.read().strip())
        # Check if process is alive
        os.kill(old_pid, 0)
        # It is running! Signal it to finish recording and exit
        os.kill(old_pid, signal.SIGUSR1)
        sys.exit(0)
    except (OSError, ValueError):
        try:
            os.remove(PID_FILE)
        except Exception:
            pass

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gdk, GLib, GtkLayerShell

CSS = b"""
window {
    background-color: transparent;
}
.voice-pill {
    background-color: rgba(14, 16, 22, 0.96);
    border: 1px solid rgba(137, 180, 250, 0.35);
    border-radius: 28px;
    padding: 8px 22px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
}
.voice-mic {
    color: #f38ba8;
    font-size: 18px;
    margin-right: 8px;
}
.voice-title {
    color: #f8f8f2;
    font-size: 14px;
    font-weight: 700;
}
.voice-hint {
    color: #a6adc8;
    font-size: 11px;
    margin-left: 10px;
}
.voice-transcribing {
    color: #89b4fa;
    font-size: 14px;
    font-weight: 600;
}
"""

class VoiceWindow(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.start_time = time.time()
        self.finished = False

        # Clean old audio file
        if os.path.exists(AUDIO_FILE):
            try:
                os.remove(AUDIO_FILE)
            except Exception:
                pass

        # Start recording via arecord with raw 16kHz mono PCM
        self.rec_proc = subprocess.Popen(
            ["arecord", "-f", "S16_LE", "-r", "16000", "-c", "1", AUDIO_FILE],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 16)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)

        style_provider = Gtk.CssProvider()
        style_provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.box.get_style_context().add_class("voice-pill")

        self.lbl_mic = Gtk.Label(label="🎙️")
        self.lbl_mic.get_style_context().add_class("voice-mic")
        self.box.pack_start(self.lbl_mic, False, False, 0)

        self.lbl_text = Gtk.Label(label="Tinglamoqdaman...")
        self.lbl_text.get_style_context().add_class("voice-title")
        self.box.pack_start(self.lbl_text, False, False, 0)

        self.lbl_hint = Gtk.Label(label="(qo'yib yuborsangiz avtomatik yoziladi)")
        self.lbl_hint.get_style_context().add_class("voice-hint")
        self.box.pack_start(self.lbl_hint, False, False, 0)

        self.add(self.box)
        self.connect("key-release-event", self.on_key_release)
        self.connect("key-press-event", self.on_key_press)
        self.connect("button-press-event", lambda *args: self.finish_dictation())
        self.connect("destroy", self.on_destroy)

        # Handle SIGUSR1 from second invocation
        signal.signal(signal.SIGUSR1, lambda *args: GLib.idle_add(self.finish_dictation))

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.cancel_dictation()
            return True
        elif event.keyval == Gdk.KEY_Return:
            self.finish_dictation()
            return True
        return False

    def on_key_release(self, widget, event):
        # Trigger when Space (32) or Super (65515/65516) is released
        if event.keyval in (Gdk.KEY_space, Gdk.KEY_Super_L, Gdk.KEY_Super_R, 65515, 65516, 32):
            elapsed = time.time() - self.start_time
            if elapsed >= 0.25:
                self.finish_dictation()
                return True
        return False

    def cancel_dictation(self):
        if self.finished:
            return
        self.finished = True
        if self.rec_proc:
            try:
                self.rec_proc.send_signal(signal.SIGINT)
                self.rec_proc.wait(timeout=0.5)
            except Exception:
                pass
        if os.path.exists(AUDIO_FILE):
            try:
                os.remove(AUDIO_FILE)
            except Exception:
                pass
        self.destroy()

    def finish_dictation(self):
        if self.finished:
            return
        self.finished = True

        # Stop recording cleanly with SIGINT so WAV header is flushed
        if self.rec_proc:
            try:
                self.rec_proc.send_signal(signal.SIGINT)
                self.rec_proc.wait(timeout=1.0)
            except Exception:
                pass

        # Update visual feedback
        self.lbl_mic.set_text("⏳")
        self.lbl_text.set_text("Matnga aylantirilmoqda...")
        self.lbl_hint.set_text("")
        self.lbl_text.get_style_context().add_class("voice-transcribing")

        # Process transcription in background thread
        threading.Thread(target=self._async_transcribe, daemon=True).start()

    def _async_transcribe(self):
        time.sleep(0.15)
        api_key = get_api_key()
        text = transcribe_audio(AUDIO_FILE, api_key) if api_key else ""

        try:
            if os.path.exists(AUDIO_FILE):
                os.remove(AUDIO_FILE)
        except Exception:
            pass

        GLib.idle_add(self._on_transcription_complete, text)

    def _on_transcription_complete(self, text):
        # First close the layer window so focus instantly returns to the previously focused window
        self.destroy()

        if text and not text.startswith("[Xatolik"):
            # Copy to clipboard
            subprocess.run(["wl-copy"], input=text, text=True)

            # Auto-paste into focused window / input field
            subprocess.Popen(["$HOME/.local/bin/waypaste"])

            # Notification preview
            preview = text[:120] + ("..." if len(text) > 120 else "")
            subprocess.run([
                "notify-send", "Diktant tayyor ✓", preview,
                "-i", "accessories-text-editor", "-t", "3500", "-a", "Voice Typing"
            ], stderr=subprocess.DEVNULL)
        else:
            if text:
                subprocess.run([
                    "notify-send", "Diktant xatosi", text,
                    "-i", "dialog-warning", "-t", "3000", "-a", "Voice Typing"
                ], stderr=subprocess.DEVNULL)

    def on_destroy(self, *args):
        if os.path.exists(PID_FILE):
            try:
                os.remove(PID_FILE)
            except Exception:
                pass
        Gtk.main_quit()

def main():
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    win = VoiceWindow()
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
